# 数据源缓存（几十 MB，不入库；CI 用 actions/cache 单独缓存）
.cache/

# 构建产物（由 CI 生成后发布到 Pages，不需要入库）
output/

# 自动生成的中间文件
channels/match-cache.json

# 日志
*.log

# 临时探查脚本（分析数据用，不进仓库）
.probe/

# 看板本地预览时拷过来的数据副本（真正的 report.json 由 CI 部署）
web/report.json

# 系统文件
.DS_Store
Thumbs.db
node_modules/

# 注：.github/workflows/ 曾因本地 token 无 workflow scope 被忽略，
# 2026-10-27 起改用 gh CLI（token 含 workflow scope）管理，已正常入库，不再忽略。

# 临时比对文件（别用 git add -A，会带进去）
.rep-*.json
.tmp-*
